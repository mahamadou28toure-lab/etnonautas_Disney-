{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/chat.js": {
      "maxDuration": 30
    },
    "api/plan.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api/chat.js"
    },
    {
      "source": "/api/plan",
      "destination": "/api/plan.js"
    }
  ]
}
